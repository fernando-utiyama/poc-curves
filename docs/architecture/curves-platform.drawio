  <diagram id="er" name="7 - Modelo de dados">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="d0" />
        <mxCell id="d1" parent="d0" />

        <mxCell id="dTitle" value="Modelo de dados — SQL Server 2022 local / Azure SQL em produção (Flyway)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="d1">
          <mxGeometry x="40" y="26" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dSub" value="Tabelas, colunas, índices e constraints em português, sem acento, em snake_case. Valores de enum permanecem em maiúsculas." style="text;html=1;fontSize=12;align=left;fontColor=#666666;" vertex="1" parent="d1">
          <mxGeometry x="40" y="56" width="1200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="dDef" value="definicao_curva&#10;──────────────&#10;id (PK)&#10;codigo (UQ)   ex.: PRE_DI1_B3 · PRE_B3_OFICIAL&#10;nome&#10;moeda&#10;modo_origem   BOOTSTRAPPED | IMPORTED&#10;horario_limite_publicacao&#10;estado        RASCUNHO | ATIVA | APOSENTADA&#10;criado_em / criado_por" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" vertex="1" parent="d1">
          <mxGeometry x="40" y="100" width="310" height="160" as="geometry" />
        </mxCell>
        <mxCell id="dDefV" value="versao_definicao_curva&#10;──────────────&#10;id (PK)&#10;definicao_curva_id (FK)&#10;numero_versao&#10;contagem_dias · calendario&#10;interpolador · politica_extrapolacao&#10;politica_arredondamento&#10;orcamento_por_etapa · janela_bloqueio&#10;limites_validacao + classificacao por teste&#10;modelo_curva_id (FK)   ← modelo apontado&#10;vinculos_fonte (conjuntos de dados exigidos)&#10;depende_de (curvas insumo)&#10;vigencia_inicio / vigencia_fim" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" vertex="1" parent="d1">
          <mxGeometry x="40" y="295" width="310" height="220" as="geometry" />
        </mxCell>
        <mxCell id="dModel" value="modelo_curva&#10;──────────────&#10;id (PK)&#10;codigo (UQ) · nome&#10;tipo       BUILTIN | GROOVY&#10;estado     ATIVO | DESABILITADO&#10;codigo_fonte (só GROOVY)&#10;checksum&#10;importado_por / importado_em" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" vertex="1" parent="d1">
          <mxGeometry x="40" y="555" width="310" height="170" as="geometry" />
        </mxCell>

        <mxCell id="dBatch" value="lote_ingestao&#10;──────────────&#10;id (PK)&#10;execucao_curva_id (FK)&#10;fonte · conjunto_dados · tipo_payload&#10;data_referencia&#10;id_evento · hash_payload&#10;pontos_recebidos / pontos_gravados&#10;divergencias (json)&#10;recebido_em" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" vertex="1" parent="d1">
          <mxGeometry x="430" y="100" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="dMd" value="ponto_dado_mercado&#10;──────────────&#10;id (PK)&#10;fonte · conjunto_dados · data_referencia&#10;chave_instrumento&#10;   UQ (fonte, conjunto_dados,&#10;         data_referencia, chave_instrumento)&#10;valor            DECIMAL(28,12)&#10;tipo_cotacao · data_vencimento&#10;lote_ingestao_id (FK)&#10;atualizado_em&#10;&#10;usado só pelo fluxo BOOTSTRAPPED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" vertex="1" parent="d1">
          <mxGeometry x="430" y="320" width="320" height="235" as="geometry" />
        </mxCell>

        <mxCell id="dRun" value="execucao_curva&#10;──────────────&#10;id (PK)&#10;correlacao_id (IX)&#10;definicao_curva_id (FK, nulo permitido)&#10;data_referencia · momento_curva&#10;disparo        AGENDADO | MANUAL | BACKFILL&#10;disparado_por&#10;faixa          ROTINA | PRIORITARIA | MASSA&#10;estado         PENDENTE | EXECUTANDO | CONSTRUINDO&#10;               | EM_RISCO | ATRASADA | CONCLUIDA&#10;               | FALHOU | SEM_DADO&#10;horario_limite · margem · duracao_por_etapa&#10;codigo_erro · mensagem_erro&#10;iniciado_em / finalizado_em" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" vertex="1" parent="d1">
          <mxGeometry x="830" y="100" width="320" height="240" as="geometry" />
        </mxCell>

        <mxCell id="dVer" value="versao_curva&#10;──────────────&#10;id (PK)&#10;definicao_curva_id (FK)&#10;versao_definicao_curva_id (FK)&#10;data_referencia&#10;momento_curva  ABERTURA | INTRADIA | FECHAMENTO&#10;numero_versao&#10;origem_versao  CALCULADA | IMPORTADA | CARREGADA&#10;estado         EM_VALIDACAO | PUBLICADA&#10;               | REPROVADA | SUBSTITUIDA&#10;execucao_curva_id (FK)&#10;publicado_em&#10;IX (definicao_curva_id, data_referencia,&#10;      momento_curva, estado)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" vertex="1" parent="d1">
          <mxGeometry x="830" y="385" width="320" height="240" as="geometry" />
        </mxCell>

        <mxCell id="dVtx" value="vertice_curva&#10;──────────────&#10;id (PK)&#10;versao_curva_id (FK)&#10;prazo_dias_uteis&#10;prazo_dias_corridos&#10;data_vencimento&#10;taxa             DECIMAL(28,12)&#10;fator_desconto   DECIMAL(28,12)&#10;IX (versao_curva_id, prazo_dias_uteis)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" vertex="1" parent="d1">
          <mxGeometry x="1230" y="385" width="300" height="200" as="geometry" />
        </mxCell>

        <mxCell id="dProv" value="procedencia_curva&#10;──────────────&#10;id (PK)&#10;versao_curva_id (FK, UQ)&#10;execucao_curva_id (FK)&#10;numero_versao_definicao&#10;modelo_curva_id (FK, nulo permitido)&#10;checksum_modelo&#10;referencias_insumo (json: fonte, conjunto,&#10;    arquivo, carimbo de tempo)&#10;hash_conjunto_insumos&#10;lote_ingestao_id (FK, nulo permitido)&#10;arquivo_carga · hash_arquivo (só CARREGADA)&#10;carregado_por · justificativa (só CARREGADA)&#10;versao_motor · criado_em" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" vertex="1" parent="d1">
          <mxGeometry x="1230" y="100" width="300" height="240" as="geometry" />
        </mxCell>

        <mxCell id="de1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="d1" source="dDef" target="dDefV"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de1b" value="N : 1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="d1" source="dDefV" target="dModel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de2" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="d1" source="dBatch" target="dMd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de3" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="d1" source="dRun" target="dBatch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de4" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="d1" source="dRun" target="dVer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de5" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="d1" source="dVer" target="dVtx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de6" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="d1" source="dVer" target="dProv"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de7" value="aplica" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;" edge="1" parent="d1" source="dDefV" target="dVer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de8" value="insumos (BOOTSTRAPPED)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;" edge="1" parent="d1" source="dMd" target="dVer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de9" value="origem (IMPORTED)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;" edge="1" parent="d1" source="dBatch" target="dProv"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="dValid" value="validacao_curva&#10;──────────────&#10;id (PK)&#10;versao_curva_id (FK)&#10;teste&#10;classificacao  BLOQUEANTE | AVISO&#10;resultado      APROVADO | REPROVADO&#10;               | NAO_APLICAVEL&#10;medida_observada · limite_aplicado&#10;executado_em" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" vertex="1" parent="d1">
          <mxGeometry x="1180" y="620" width="290" height="180" as="geometry" />
        </mxCell>
        <mxCell id="deValid" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="d1" source="dVer" target="dValid"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dNote" value="Regras que o modelo impõe&#10;──────────────────────────────────────────&#10;• Todo valor de mercado é DECIMAL(28,12) — nunca FLOAT.&#10;• ponto_dado_mercado é upsert idempotente pela chave única; reprocessar não duplica, e divergência de valor fica registrada no lote.&#10;• Nova publicação da mesma (curva, data, momento) cria versão nova e marca a anterior como SUBSTITUIDA — nunca UPDATE em vértice.&#10;• versao_curva só chega a PUBLICADA com procedencia_curva gravada na MESMA transação.&#10;• Versão CALCULADA exige modelo_curva_id na procedência; IMPORTADA exige lote_ingestao_id; CARREGADA exige arquivo, hash, autor e justificativa.&#10;• Consulta sem versão devolve a PUBLICADA corrente; com asOf devolve a que vigorava naquele instante.&#10;&#10;Quem escreve o quê&#10;• curve-processor → ponto_dado_mercado, lote_ingestao e as versões que chegaram prontas (IMPORTADA e CARREGADA)&#10;• curve-engine → as versões que ele calculou (CALCULADA) e modelo_curva&#10;• curve-api → definicao_curva e versao_definicao_curva&#10;• curve-orchestrator → execucao_curva" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="d1">
          <mxGeometry x="430" y="600" width="1100" height="290" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
