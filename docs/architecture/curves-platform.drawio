        <mxCell id="proc" value="curve-processor — Java / Spring Boot&#10;──────────────&#10;um listener por FAIXA (thread isolada)&#10;valida envelope → roteia por payloadKind&#10;&#10;INDIVIDUAL_QUOTES → parser por dataset&#10;→ transação por BLOCO · lote fecha por contagem&#10;→ lote incompleto NÃO gera construção&#10;&#10;READY_CURVE → publica curva IMPORTADA&#10;MANUAL (CSV/planilha) → publica curva CARREGADA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="k1">
          <mxGeometry x="890" y="200" width="270" height="180" as="geometry" />
        </mxCell>

        <mxCell id="engine" value="curve-engine (motor de cálculo) — Java / Spring Boot&#10;──────────────&#10;construção assíncrona (BOOTSTRAPPED)&#10;   resolve definição + versão + modelo&#10;   resolve insumos → gate de faltante&#10;   executa modelo → grava EM_VALIDACAO&#10;&#10;interpolação síncrona (as duas origens)&#10;   sobre vértices publicados · cache Redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="k1">
          <mxGeometry x="890" y="420" width="270" height="180" as="geometry" />
        </mxCell>

        <mxCell id="valid" value="curve-validator — GATE de publicação&#10;──────────────&#10;reprecificação dos instrumentos de calibração&#10;fatores de desconto decrescentes · forwards nos limites&#10;faixa de taxas · suavidade · cobertura&#10;variação contra o dia anterior (aviso)&#10;&#10;BLOQUEANTE reprova → não publica&#10;AVISO → publica sinalizado&#10;EM_VALIDACAO → PUBLICADA | REPROVADA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;fontStyle=1;" vertex="1" parent="k1">
