{
  "name": "@poc-curvas/feeder-marketdata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync-contracts": "node scripts/sync-contracts.mjs",
    "prebuild": "npm run sync-contracts",
    "build": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run sync-contracts",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@azure/functions": "4.16.2",
    "adm-zip": "0.6.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "kafkajs": "2.2.4",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/adm-zip": "0.5.8",
    "@types/node": "20.19.43",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
