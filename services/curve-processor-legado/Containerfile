# syntax=docker/dockerfile:1
#
# Contexto de build DEVE ser a raiz do monorepo (o serviço depende do reactor
# Maven inteiro): podman build -f services/curve-processor/Containerfile -t curve-processor .

FROM docker.io/library/maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY . .
RUN mvn -q -pl services/curve-processor -am package -DskipTests

FROM docker.io/library/eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /workspace/services/curve-processor/target/curve-processor-*.jar app.jar

EXPOSE 8081
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
  CMD wget -qO- http://localhost:8081/actuator/health | grep -q '"status":"UP"' || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
