<?xml version="1.0" encoding="UTF-8"?>
<!--
  Este POM raiz é filho de spring-boot-starter-parent para que TODOS os módulos
  herdem o gerenciamento de versão de dependências (JUnit, AssertJ, Testcontainers,
  driver JDBC, Flyway) sem precisar redeclarar versão em cada filho — herança de
  <dependencyManagement> não adiciona dependência nenhuma sozinha, só disponibiliza
  a versão para quando o filho decidir declarar.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.poccurves</groupId>
    <artifactId>poc-curves-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>poc-curves</name>
    <description>POC executável da plataforma de curvas de Tesouraria/Risco — monorepo multi-módulo Maven.</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <archunit.version>1.5.0</archunit.version>
        <h2.version>2.3.232</h2.version>
        <azure.storage.blob.version>12.30.0</azure.storage.blob.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-storage-blob</artifactId>
                <version>${azure.storage.blob.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>services/common</module>
        <module>services/curve-processor</module>
        <module>services/curve-engine</module>
        <module>services/curve-api</module>
        <module>services/curve-bff</module>
        <module>services/curve-orchestrator</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>ban-lombok</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.projectlombok:lombok</exclude>
                                    </excludes>
                                    <message>Lombok é proibido neste projeto — usar records e código explícito.</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
